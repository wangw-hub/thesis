{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:epoch-auth:r3:header:v1",
  "title":"Research Content 3 Versioned Header V1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","suiteId","chainId","authorizationContract","headerRegistry","resourceId","bodyReference","bodyDigest","bodyVersion","policyDigest","epoch","stateVersion","headerVersion","keyVersion","previousHeaderDigest","bodyFormat","recipientEnvelopes","createdAt","issuerId","metadataDigest","issuerSignature"],
  "properties":{
    "schemaVersion":{"const":"1"},
    "suiteId":{"const":"R3-A256GCM-CHUNKED-HPKE-X25519-HKDF256-A128GCM-ED25519"},
    "chainId":{"$ref":"#/$defs/u64"},
    "authorizationContract":{"$ref":"#/$defs/address"},
    "headerRegistry":{"$ref":"#/$defs/address"},
    "resourceId":{"$ref":"#/$defs/hash32"},
    "bodyReference":{"type":"string","minLength":1,"maxLength":2048},
    "bodyDigest":{"$ref":"#/$defs/hash32"},
    "bodyVersion":{"$ref":"#/$defs/u64positive"},
    "policyDigest":{"$ref":"#/$defs/hash32"},
    "epoch":{"$ref":"#/$defs/u64positive"},
    "stateVersion":{"$ref":"#/$defs/u64positive"},
    "headerVersion":{"$ref":"#/$defs/u64positive"},
    "keyVersion":{"$ref":"#/$defs/u64positive"},
    "previousHeaderDigest":{"$ref":"#/$defs/hash32"},
    "bodyFormat":{
      "type":"object","additionalProperties":false,
      "required":["formatVersion","chunkSize","chunkCount","plaintextLength","nonceBase"],
      "properties":{
        "formatVersion":{"const":"1"},
        "chunkSize":{"enum":["1048576","2097152","4194304","8388608","16777216"]},
        "chunkCount":{"type":"string","pattern":"^(?:[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$"},
        "plaintextLength":{"$ref":"#/$defs/u64positive"},
        "nonceBase":{"type":"string","pattern":"^[A-Za-z0-9_-]{11}$"}
      }
    },
    "recipientEnvelopes":{"type":"array","minItems":1,"maxItems":100000,"items":{"$ref":"#/$defs/envelope"}},
    "createdAt":{"type":"string","format":"date-time","pattern":"Z$"},
    "issuerId":{"type":"string","minLength":1,"maxLength":255},
    "metadataDigest":{"$ref":"#/$defs/hash32"},
    "issuerSignature":{"type":"string","pattern":"^[A-Za-z0-9_-]{86}$"}
  },
  "$defs":{
    "u64":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
    "u64positive":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"},
    "address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
    "hash32":{"type":"string","pattern":"^0x[0-9a-f]{64}$"},
    "envelope":{
      "type":"object","additionalProperties":false,
      "required":["recipientKeyId","userVersion","encapsulation","wrappedKey"],
      "properties":{
        "recipientKeyId":{"$ref":"#/$defs/hash32"},
        "userVersion":{"$ref":"#/$defs/u64positive"},
        "encapsulation":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},
        "wrappedKey":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^[A-Za-z0-9_-]+$"}
      }
    }
  }
}
