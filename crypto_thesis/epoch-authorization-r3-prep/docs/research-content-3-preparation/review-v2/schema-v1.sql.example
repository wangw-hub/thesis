-- DESIGN ONLY. DO NOT EXECUTE.
CREATE SCHEMA IF NOT EXISTS r3_control;

CREATE TABLE r3_control.chain_event (
    event_id BYTEA PRIMARY KEY CHECK (octet_length(event_id)=32),
    chain_id BIGINT NOT NULL CHECK (chain_id>0),
    authorization_contract BYTEA NOT NULL CHECK (octet_length(authorization_contract)=20),
    event_signature BYTEA NOT NULL CHECK (octet_length(event_signature)=32),
    transaction_hash BYTEA NOT NULL CHECK (octet_length(transaction_hash)=32),
    log_index INTEGER NOT NULL CHECK (log_index>=0),
    block_number BIGINT NOT NULL CHECK (block_number>=0),
    block_hash BYTEA NOT NULL CHECK (octet_length(block_hash)=32),
    resource_id BYTEA NOT NULL CHECK (octet_length(resource_id)=32),
    target_epoch BIGINT NOT NULL CHECK (target_epoch>0),
    target_state_version BIGINT NOT NULL CHECK (target_state_version>0),
    status TEXT NOT NULL CHECK (status IN ('OBSERVED','SAFE','REORGED','APPLIED')),
    created_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
    UNIQUE(chain_id, authorization_contract, transaction_hash, log_index)
);

CREATE TABLE r3_control.revocation_event_cursor (
    chain_id BIGINT NOT NULL,
    authorization_contract BYTEA NOT NULL CHECK (octet_length(authorization_contract)=20),
    event_signature BYTEA NOT NULL CHECK (octet_length(event_signature)=32),
    safe_block_number BIGINT NOT NULL CHECK (safe_block_number>=0),
    safe_block_hash BYTEA NOT NULL CHECK (octet_length(safe_block_hash)=32),
    row_version BIGINT NOT NULL DEFAULT 1 CHECK (row_version>0),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
    PRIMARY KEY(chain_id, authorization_contract, event_signature)
);

CREATE TABLE r3_control.header_update_job (
    operation_id BYTEA PRIMARY KEY CHECK (octet_length(operation_id)=32),
    event_id BYTEA NOT NULL REFERENCES r3_control.chain_event(event_id),
    header_registry BYTEA NOT NULL CHECK (octet_length(header_registry)=20),
    resource_id BYTEA NOT NULL CHECK (octet_length(resource_id)=32),
    target_epoch BIGINT NOT NULL CHECK (target_epoch>0),
    target_state_version BIGINT NOT NULL CHECK (target_state_version>0),
    target_key_version BIGINT NOT NULL CHECK (target_key_version>0),
    status TEXT NOT NULL CHECK (status IN ('READY','CLAIMED','CANDIDATE_BUILT','STORED_VERIFIED','TX_RESERVED','TX_BROADCAST','UNKNOWN','RETRY','COMMITTED','DEAD')),
    row_version BIGINT NOT NULL DEFAULT 1 CHECK (row_version>0),
    retry_count INTEGER NOT NULL DEFAULT 0 CHECK (retry_count>=0),
    available_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
    lease_owner TEXT,
    lease_until TIMESTAMPTZ,
    last_error_code TEXT,
    last_error_detail TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp()
);
CREATE INDEX header_update_job_claim_idx
  ON r3_control.header_update_job(status, available_at, operation_id);

CREATE TABLE r3_control.storage_object (
    object_digest BYTEA PRIMARY KEY CHECK (octet_length(object_digest)=32),
    backend TEXT NOT NULL CHECK (backend IN ('LOCAL','IPFS')),
    object_reference TEXT NOT NULL,
    byte_length BIGINT NOT NULL CHECK (byte_length>=0),
    verify_status TEXT NOT NULL CHECK (verify_status IN ('PENDING','VERIFIED','FAILED')),
    pin_status TEXT NOT NULL CHECK (pin_status IN ('NOT_APPLICABLE','PENDING','PINNED','FAILED')),
    created_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
    verified_at TIMESTAMPTZ,
    UNIQUE(backend, object_reference)
);

CREATE TABLE r3_control.header_version (
    resource_id BYTEA NOT NULL CHECK (octet_length(resource_id)=32),
    header_version BIGINT NOT NULL CHECK (header_version>0),
    key_version BIGINT NOT NULL CHECK (key_version>0),
    operation_id BYTEA NOT NULL UNIQUE REFERENCES r3_control.header_update_job(operation_id),
    header_digest BYTEA NOT NULL UNIQUE CHECK (octet_length(header_digest)=32),
    previous_header_digest BYTEA NOT NULL CHECK (octet_length(previous_header_digest)=32),
    object_digest BYTEA NOT NULL REFERENCES r3_control.storage_object(object_digest),
    status TEXT NOT NULL CHECK (status IN ('CANDIDATE','STORED','TX_PENDING','ACTIVE','SUPERSEDED','ORPHAN_QUARANTINED')),
    row_version BIGINT NOT NULL DEFAULT 1 CHECK (row_version>0),
    created_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
    PRIMARY KEY(resource_id, header_version),
    UNIQUE(resource_id, key_version)
);
CREATE UNIQUE INDEX header_version_one_active
  ON r3_control.header_version(resource_id) WHERE status='ACTIVE';

CREATE TABLE r3_control.commit_attempt (
    operation_id BYTEA NOT NULL REFERENCES r3_control.header_update_job(operation_id),
    attempt_no INTEGER NOT NULL CHECK (attempt_no>0),
    nonce_reservation_id TEXT,
    transaction_hash BYTEA UNIQUE CHECK (transaction_hash IS NULL OR octet_length(transaction_hash)=32),
    status TEXT NOT NULL CHECK (status IN ('RESERVED','BROADCAST','CONFIRMED','REVERTED','UNKNOWN','ABANDONED')),
    error_code TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
    PRIMARY KEY(operation_id, attempt_no)
);

CREATE TABLE r3_control.recovery_audit (
    audit_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    operation_id BYTEA CHECK (operation_id IS NULL OR octet_length(operation_id)=32),
    action TEXT NOT NULL,
    before_state JSONB,
    after_state JSONB,
    reason_code TEXT NOT NULL,
    actor_id TEXT NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp()
);

CREATE TABLE r3_control.dead_letter_job (
    operation_id BYTEA PRIMARY KEY REFERENCES r3_control.header_update_job(operation_id),
    failure_snapshot JSONB NOT NULL,
    disposition TEXT CHECK (disposition IN ('UNRESOLVED','REQUEUED','ACCEPTED_LIMITATION','CANCELLED')),
    created_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
    resolved_at TIMESTAMPTZ,
    resolved_by TEXT
);
